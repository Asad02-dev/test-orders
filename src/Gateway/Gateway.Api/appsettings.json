{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/ecommerce",
    "Audience": "account"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:05:00",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "catalog-https": {
            "Address": "https://localhost:7214"
          },
          "catalog-http": {
            "Address": "http://localhost:5219"
          }
        }
      },
      "cart-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:05:00",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "cart-https": {
            "Address": "https://localhost:7060"
          },
          "cart-http": {
            "Address": "http://localhost:5174"
          }
        }
      },
      "orders-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:05:00",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "orders-https": {
            "Address": "https://localhost:7085"
          },
          "orders-http": {
            "Address": "http://localhost:5189"
          }
        }
      },
      "inventory-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:05:00",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "inventory-https": {
            "Address": "https://localhost:7207"
          },
          "inventory-http": {
            "Address": "http://localhost:5110"
          }
        }
      },
      "payments-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:05:00",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "payments-https": {
            "Address": "https://localhost:7203"
          },
          "payments-http": {
            "Address": "http://localhost:5257"
          }
        }
      },
      "notifications-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:05:00",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "notifications-https": {
            "Address": "https://localhost:7175"
          },
          "notifications-http": {
            "Address": "http://localhost:5156"
          }
        }
      }
    }
  }
}
